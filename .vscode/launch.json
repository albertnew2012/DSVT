            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: train onestage_nusences",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/train.py",
            "console": "internalConsole",
            "args": [
                "--cfg_file",
                "tools/cfgs/dsvt_models/dsvt_plain_1f_onestage_nusences_debug.yaml",
                // "--pretrained_model",
                // "output/cfgs/dsvt_models/dsvt_plain_1f_onestage_nusences_debug/default/ckpt/checkpoint_epoch_24.pth"
